DATABASE_URL=sqlite:///./authguard.db

JWT_SECRET_KEY=change-me-run-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=60

ADMIN_USERNAME=admin
# Generate hash: python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('yourpassword'))"
ADMIN_PASSWORD_HASH=

# Optional — omit to disable; Safe Browsing degrades gracefully without it
SAFE_BROWSING_API_KEY=

# For production, replace * with your dashboard origin
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
